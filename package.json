{
  "name": "minimi-plaza",
  "version": "0.1.0",
  "private": true,
  "description": "미니미 광장 — 나만의 미니미로 친구들과 모이는 P2P 광장 + 불꽃놀이",
  "main": "./out/main/index.js",
  "author": "kanchoooo",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:two": "node scripts/dev-two.mjs",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist:mac": "electron-vite build && APPLE_KEYCHAIN_PROFILE=${APPLE_KEYCHAIN_PROFILE:-minimi-notary} electron-builder --mac --universal --publish never",
    "dist:mac:local": "electron-vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --dir --publish never",
    "dist:win": "electron-vite build && electron-builder --win --x64 --publish never",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "pixi.js": "^8.22.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "trystero": "^0.26.0",
    "typescript": "5.9",
    "vite": "^7.3.7"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kanchoooo/minimi-plaza.git"
  }
}
